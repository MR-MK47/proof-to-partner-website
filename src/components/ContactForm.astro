---
---
<form id="inquiry-form" class="space-y-6" novalidate>
  <div><label class="field-label" for="inquiry-type">What would you like to discuss? *</label><select class="field-control" id="inquiry-type" name="type" required><option value="general">General contact</option><option value="buyer">A buyer requirement</option><option value="supplier">A supplier introduction</option></select><p class="field-hint mt-2">Choose the option that best describes your enquiry.</p></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><label class="field-label" for="name">Your name *</label><input class="field-control" id="name" name="name" autocomplete="name" maxlength="100" required placeholder="Full name" /></div><div><label class="field-label" for="email">Work email *</label><input class="field-control" id="email" name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@company.com" /></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><label class="field-label" for="company">Company / organisation</label><input class="field-control" id="company" name="company" autocomplete="organization" maxlength="160" placeholder="Company name" /></div><div><label class="field-label" for="website">Company website</label><input class="field-control" id="website" name="website" type="url" inputmode="url" maxlength="300" placeholder="https://example.com" /></div></div>
  <div class="grid gap-5 sm:grid-cols-2"><div><label class="field-label" for="location">Location / coverage</label><input class="field-control" id="location" name="location" maxlength="160" placeholder="City, region or countries" /></div><div><label class="field-label" for="category">Product, service or category</label><input class="field-control" id="category" name="category" maxlength="160" placeholder="What is the requirement or capability?" /><p id="category-hint" class="field-hint mt-2">Optional for general enquiries.</p></div></div>
  <div id="timing-wrap"><label class="field-label" for="timing">Timing / urgency</label><select class="field-control" id="timing" name="timing"><option value="">Not specified</option><option value="Immediately / urgent">Immediately / urgent</option><option value="Within 30 days">Within 30 days</option><option value="Within 1–3 months">Within 1–3 months</option><option value="Planning / exploring">Planning / exploring</option><option value="Ongoing supplier capability">Ongoing supplier capability</option></select></div>
  <div><label class="field-label" for="message">Tell us what you have in mind *</label><textarea class="field-control min-h-36 resize-y" id="message" name="message" rows="5" minlength="10" maxlength="5000" required placeholder="Share the key details, constraints, and what a useful next step would look like. Avoid sensitive or confidential information."></textarea><p class="field-hint mt-2">10–5,000 characters. Do not include passwords, payment details or confidential information you are not authorised to share.</p></div>
  <div class="honeypot" aria-hidden="true"><label for="company-fax">Leave this field empty</label><input id="company-fax" name="company_fax" tabindex="-1" autocomplete="off" /></div><input type="hidden" id="form-started-at" name="form_started_at" /><input type="hidden" id="turnstile-token" name="turnstile_token" /><div id="turnstile-container" class="hidden" aria-label="Spam prevention verification"></div>
  <div class="flex items-start gap-3"><input class="mt-1 size-4 accent-brand" id="consent" name="consent" type="checkbox" value="yes" required /><label for="consent" class="text-sm leading-6 text-muted">I agree that Proof to Partner may use these details to respond to my enquiry, as described in the <a class="font-semibold text-brand-deep underline" href="/privacy/">Privacy Policy</a>. *</label></div>
  <div id="form-status" class="form-status hidden" role="status" aria-live="polite" aria-atomic="true"></div><button id="submit-button" class="btn-primary w-full sm:w-auto" type="submit">Send enquiry ↗</button><p class="field-hint">We aim to review enquiries within two business days. This is a target, not a guarantee. A successful submission does not guarantee an introduction or commercial outcome.</p>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>('#inquiry-form');
  const statusBox = document.querySelector<HTMLDivElement>('#form-status');
  const submitButton = document.querySelector<HTMLButtonElement>('#submit-button');
  const typeField = document.querySelector('#inquiry-type') as unknown as HTMLSelectElement | null;
  const companyField = document.querySelector<HTMLInputElement>('#company');
  const categoryField = document.querySelector<HTMLInputElement>('#category');
  const categoryHint = document.querySelector<HTMLParagraphElement>('#category-hint');
  const timingField = document.querySelector('#timing') as unknown as HTMLSelectElement | null;
  const timingWrap = document.querySelector<HTMLDivElement>('#timing-wrap');
  const startField = document.querySelector<HTMLInputElement>('#form-started-at');
  const tokenField = document.querySelector<HTMLInputElement>('#turnstile-token');
  const turnstileContainer = document.querySelector<HTMLDivElement>('#turnstile-container');
  let widgetId: string | undefined;
  let turnstileRequired = false;
  if (form && statusBox && submitButton && typeField && startField) {
    const requestedType = new URLSearchParams(window.location.search).get('type');
    if (requestedType === 'buyer' || requestedType === 'supplier' || requestedType === 'general') typeField.value = requestedType;
    startField.value = String(Math.floor(Date.now() / 1000));
    const updateFields = () => {
      const businessType = typeField.value === 'buyer' || typeField.value === 'supplier';
      if (companyField) companyField.required = businessType;
      if (categoryField) categoryField.required = businessType;
      if (categoryHint) categoryHint.textContent = businessType ? 'Required for this enquiry type.' : 'Optional for general enquiries.';
      if (timingField) timingField.required = typeField.value === 'buyer';
      if (timingWrap) timingWrap.classList.toggle('hidden', typeField.value === 'general');
    };
    typeField.addEventListener('change', updateFields);
    updateFields();
    const setStatus = (message: string, state: 'success' | 'error') => { statusBox.textContent = message; statusBox.dataset.state = state; statusBox.classList.remove('hidden'); };
    const loadTurnstile = async () => {
      try {
        const response = await fetch('/api/config', { headers: { Accept: 'application/json' } });
        if (!response.ok) return;
        const config = await response.json() as { turnstileSiteKey?: string | null };
        if (!config.turnstileSiteKey || !turnstileContainer || !tokenField) return;
        turnstileRequired = true; turnstileContainer.classList.remove('hidden');
        const renderWidget = () => {
          if (!window.turnstile || !turnstileContainer) return;
          widgetId = window.turnstile.render(turnstileContainer, {
            sitekey: config.turnstileSiteKey as string, theme: 'light',
            callback: (token: string) => { if (tokenField) tokenField.value = token; },
            'expired-callback': () => { if (tokenField) tokenField.value = ''; },
            'error-callback': () => { if (tokenField) tokenField.value = ''; setStatus('The security check could not be completed. Refresh the page and try again.', 'error'); },
          });
        };
        if (window.turnstile) renderWidget();
        else { const script = document.createElement('script'); script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'; script.async = true; script.defer = true; script.onload = renderWidget; script.onerror = () => setStatus('The security check could not load. Refresh and try again.', 'error'); document.head.appendChild(script); }
      } catch { /* Optional when no Turnstile widget is configured. */ }
    };
    void loadTurnstile();
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); statusBox.classList.add('hidden');
      if (!form.reportValidity()) return;
      if (turnstileRequired && (!tokenField || !tokenField.value)) { setStatus('Please complete the security check before submitting.', 'error'); return; }
      submitButton.disabled = true; submitButton.textContent = 'Sending…';
      const payload: Record<string, string> = {};
      new FormData(form).forEach((value, key) => { payload[key] = String(value); });
      try {
        const response = await fetch('/api/inquiries', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) });
        const result = await response.json() as { ok?: boolean; message?: string; error?: string };
        if (!response.ok || !result.ok) throw new Error(result.error || 'We could not submit your enquiry. Check your details and try again.');
        form.reset(); startField.value = String(Math.floor(Date.now() / 1000)); if (tokenField) tokenField.value = '';
        if (widgetId && window.turnstile) window.turnstile.reset(widgetId);
        updateFields(); setStatus(result.message || 'Thank you. Your enquiry has been saved.', 'success');
      } catch (error) { setStatus(error instanceof Error ? error.message : 'Something went wrong. Please try again.', 'error'); }
      finally { submitButton.disabled = false; submitButton.innerHTML = 'Send enquiry <span aria-hidden="true">↗</span>'; }
    });
  }
</script>